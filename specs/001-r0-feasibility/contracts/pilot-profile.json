{
  "profile_version": "0.2.0",
  "profile_id": "macos-arm64-proof",
  "host": {
    "os": "macOS",
    "os_version": "26.5.1",
    "arch": "arm64",
    "minimum_logical_cpus": 4,
    "minimum_memory_mib": 16384,
    "required_run_metadata": ["hardware_model", "logical_cpus", "memory_mib", "os_build", "kernel", "filesystem", "storage", "dependency_versions", "fixture_digests"]
  },
  "toolchain": {
    "rust": "1.100.0",
    "component_target": "wasm32-wasip2"
  },
  "transport": {
    "required_modes": ["http1_forward", "https_connect_tunnel", "https_http1_intercept", "https_http2_intercept"],
    "bind": "loopback",
    "fixture_scope": "explicit-address-and-ephemeral-port-grants",
    "client_trust": "isolated-test-client-only",
    "upstream_tls_verification": true,
    "requests_per_case": 20,
